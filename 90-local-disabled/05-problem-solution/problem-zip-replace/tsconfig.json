{
  "compilerOptions": {
    "target": "es2020",
    "module": "commonjs",
    "esModuleInterop": true,
    "moduleResolution": "node",
    "sourceMap": false,
    "composite": true,
    "strictBindCallApply": true,
    "resolveJsonModule": true,
    "experimentalDecorators": true,
    "incremental": true,
    "rootDir": "."
  },
  "include": [
    "**/*.ts"
  ],
  "exclude": [
    "public",
    "frontend"
  ]
}
