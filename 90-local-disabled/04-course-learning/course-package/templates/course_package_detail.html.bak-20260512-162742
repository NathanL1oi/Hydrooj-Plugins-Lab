{% import "components/user.html" as user with context %}
{% extends "layout/basic.html" %}
{% block content %}
<style>
.course-package-detail .section { border-radius: 8px; overflow: hidden; }
.course-package-detail .cp-version { border: 1px solid #e8edf3; border-radius: 8px; margin: 12px 0; padding: 16px; background: #fff; }
.course-package-detail .cp-version:hover { border-color: #cbd5e1; }
.course-package-detail .cp-version-meta { display: flex; flex-wrap: wrap; gap: 10px; color: #64748b; }
.course-package-detail .cp-version-meta span { display: inline-flex; align-items: center; gap: 4px; }
</style>
{% include "course_package_style.html" %}
<div class="row course-package-detail course-package-ui" data-sticky-parent>
  <div class="medium-9 columns">
    <div class="section">
      <div class="section__header">
        <h1 class="section__title">{{ _('课程包') }}: {{ cpdoc.title }}</h1>
      </div>
      <div class="section__body typo richmedia">
        {{ cpdoc.content|default('')|markdown|safe }}
      </div>
    </div>
    <div class="section">
      <div class="section__header">
        <h1 class="section__title">{{ _('版本') }}</h1>
      </div>
      {% if not versions.length %}
      <div class="section__body typo"><p>{{ _('暂无版本') }}</p></div>
      {% else %}
      <ol class="section__list discussion__list">
        {% for vpdoc in versions %}
        <li class="section__list__item discussion__item cp-version">
          <div class="media">
            <div class="media__body middle">
              <h1 class="discussion__title">
                <a href="{{ url('course_package_version_detail', cpid=cpdoc.docId, vid=vpdoc.docId) }}">{{ vpdoc.title }}</a>
              </h1>
              <ul class="supplementary list">
                <li class="cp-version-meta">
                  <span>{{ vpdoc.version }}</span>
                  <span>{{ vpdoc.summary.chapterCount }} {{ _('章') }}</span>
                  <span>{{ vpdoc.summary.lessonCount }} {{ _('节') }}</span>
                  <span>{{ vpdoc.summary.problemCount }} {{ _('题目') }}</span>
                </li>
              </ul>
            </div>
          </div>
        </li>
        {% endfor %}
      </ol>
      {% endif %}
    </div>
  </div>
  <div class="medium-3 columns" data-sticky="large">
    <div class="section side">
      <ol class="menu">
        {% if canManage %}
        <li class="menu__item"><a class="menu__link" href="{{ url('course_package_edit', cpid=cpdoc.docId) }}"><span class="icon icon-edit"></span> {{ _('Edit') }}</a></li>
        <li class="menu__item"><a class="menu__link" href="{{ url('course_package_version_create', cpid=cpdoc.docId) }}"><span class="icon icon-add"></span> {{ _('创建版本') }}</a></li>
        <li class="menu__item"><a class="menu__link" href="{{ url('course_package_version_order', cpid=cpdoc.docId) }}"><span class="icon icon-sliders"></span> {{ _('调整版本顺序') }}</a></li>
        {% endif %}
      </ol>
      <div class="section__body typo">
        <dl class="large horizontal">
          <dt>{{ _('Created By') }}</dt>
          <dd>{{ user.render_inline(udoc, badge=false) }}</dd>
        </dl>
      </div>
    </div>
  </div>
</div>
{% endblock %}
