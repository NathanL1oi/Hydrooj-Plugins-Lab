{% extends "layout/basic.html" %}
{% block content %}
{% include "course_package_style.html" %}
<style>
.cp-tree-sort { --cp-border: #dbe4ef; --cp-soft: #f8fafc; --cp-text: #172033; --cp-muted: #64748b; font-size: 14px; }
.cp-tree-sort .section { border-radius: 8px; overflow: hidden; }
.cp-tree-sort .section__header { padding: 14px 16px; }
.cp-tree-sort .section__title { font-size: 20px; line-height: 1.35; }
.cp-tree-list, .cp-lesson-sort-list { list-style: none; margin: 0; padding: 0; display: grid; gap: 10px; }
.cp-chapter-sort { border: 1px solid var(--cp-border); border-radius: 8px; background: #fff; overflow: hidden; }
.cp-sort-head, .cp-lesson-sort { display: grid; grid-template-columns: 44px minmax(0, 1fr) auto; gap: 12px; align-items: center; padding: 12px 14px; }
.cp-sort-head { background: #fbfdff; border-bottom: 1px solid #edf2f7; }
.cp-lesson-sort { margin: 8px 12px; border: 1px solid #edf2f7; border-radius: 8px; background: #fff; }
.cp-sort-index { display: inline-flex; width: 30px; height: 30px; align-items: center; justify-content: center; border-radius: 50%; background: #e8f2ff; color: #0f172a; }
.cp-lesson-sort .cp-sort-index { width: 26px; height: 26px; background: #f1f5f9; font-size: 12px; }
.cp-sort-title { margin: 0; color: var(--cp-text); font-size: 16px; line-height: 1.35; }
.cp-lesson-sort .cp-sort-title { font-size: 14px; }
.cp-sort-meta { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 4px; color: var(--cp-muted); font-size: 12px; }
.cp-sort-actions { display: flex; flex-wrap: wrap; justify-content: flex-end; gap: 6px; }
.cp-sort-actions .button { margin: 0 !important; height: 30px; padding: 0 10px; line-height: 28px; font-size: 13px; }
.cp-sort-footer { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 14px; }
.cp-empty { margin: 8px 12px 12px; padding: 12px; border: 1px dashed #cbd5e1; border-radius: 8px; color: var(--cp-muted); }
@media screen and (max-width: 760px) {
  .cp-sort-head, .cp-lesson-sort { grid-template-columns: 36px minmax(0, 1fr); }
  .cp-sort-actions { grid-column: 2; justify-content: flex-start; }
}
</style>
<div class="row cp-tree-sort course-package-ui">
  <div class="medium-12 columns">
    <form method="post" data-cp-tree-sort>
      <input type="hidden" name="order" data-cp-structure-input>
      <div class="section">
        <div class="section__header">
          <h1 class="section__title">{{ _('结构排序') }}: {{ cpdoc.title }} / {{ vpdoc.version }}</h1>
          <div class="section__tools">
            <button type="submit" class="rounded primary button">{{ _('保存排序') }}</button>
            <button type="button" class="rounded button" data-cp-reset>{{ _('撤销更改') }}</button>
            <a class="rounded button" href="{{ url('course_package_version_detail', cpid=cpdoc.docId, vid=vpdoc.docId) }}">{{ _('返回') }}</a>
          </div>
        </div>
        <div class="section__body">
          {% if not chapters.length %}
          <p>{{ _('这个版本还没有章。') }}</p>
          {% else %}
          <ol class="cp-tree-list" data-chapter-list>
            {% for chapter in chapters %}
            <li class="cp-chapter-sort" data-cp-chapter-item data-id="{{ chapter.id }}">
              <div class="cp-sort-head">
                <span class="cp-sort-index" data-cp-chapter-index>{{ loop.index }}</span>
                <div>
                  <h2 class="cp-sort-title">{{ chapter.title }}</h2>
                  <div class="cp-sort-meta">
                    <span>{{ chapter.lessons.length }} {{ _('节') }}</span>
                  </div>
                </div>
                <div class="cp-sort-actions">
                  <button type="button" class="rounded button" data-sort-scope="chapter" data-sort-action="top">{{ _('置顶') }}</button>
                  <button type="button" class="rounded button" data-sort-scope="chapter" data-sort-action="up">{{ _('上移') }}</button>
                  <button type="button" class="rounded button" data-sort-scope="chapter" data-sort-action="down">{{ _('下移') }}</button>
                  <button type="button" class="rounded button" data-sort-scope="chapter" data-sort-action="bottom">{{ _('置底') }}</button>
                </div>
              </div>
              {% if chapter.lessons.length %}
              <ol class="cp-lesson-sort-list" data-lesson-list>
                {% for lesson in chapter.lessons %}
                <li class="cp-lesson-sort" data-cp-lesson-item data-id="{{ lesson.id }}">
                  <span class="cp-sort-index" data-cp-lesson-index>{{ loop.index }}</span>
                  <div>
                    <h3 class="cp-sort-title">{{ lesson.title }}</h3>
                    <div class="cp-sort-meta">
                      <span>{{ lesson.pids.length }} {{ _('题目') }}</span>
                    </div>
                  </div>
                  <div class="cp-sort-actions">
                    <button type="button" class="rounded button" data-sort-scope="lesson" data-sort-action="top">{{ _('置顶') }}</button>
                    <button type="button" class="rounded button" data-sort-scope="lesson" data-sort-action="up">{{ _('上移') }}</button>
                    <button type="button" class="rounded button" data-sort-scope="lesson" data-sort-action="down">{{ _('下移') }}</button>
                    <button type="button" class="rounded button" data-sort-scope="lesson" data-sort-action="bottom">{{ _('置底') }}</button>
                  </div>
                </li>
                {% endfor %}
              </ol>
              {% else %}
              <div class="cp-empty">{{ _('本章还没有节。') }}</div>
              {% endif %}
            </li>
            {% endfor %}
          </ol>
          <div class="cp-sort-footer">
            <button type="submit" class="rounded primary button">{{ _('保存排序') }}</button>
            <button type="button" class="rounded button" data-cp-reset>{{ _('撤销更改') }}</button>
          </div>
          {% endif %}
        </div>
      </div>
    </form>
  </div>
</div>
<script>
(function() {
  var root = document.querySelector('[data-cp-tree-sort]');
  if (!root) return;
  var chapterList = root.querySelector('[data-chapter-list]');
  var input = root.querySelector('[data-cp-structure-input]');
  if (!chapterList || !input) return;
  function directItems(parent, selector) {
    return Array.prototype.filter.call(parent.children, function(child) {
      return child.matches(selector);
    });
  }
  function refreshList(parent, itemSelector, indexSelector) {
    var rows = directItems(parent, itemSelector);
    rows.forEach(function(row, index) {
      var indexNode = row.querySelector(indexSelector);
      if (indexNode) indexNode.textContent = String(index + 1);
      row.querySelectorAll('[data-sort-action]').forEach(function(button) {
        var action = button.getAttribute('data-sort-action');
        if (action === 'top' || action === 'up') button.disabled = index === 0;
        if (action === 'down' || action === 'bottom') button.disabled = index === rows.length - 1;
      });
    });
  }
  function refresh() {
    refreshList(chapterList, '[data-cp-chapter-item]', '[data-cp-chapter-index]');
    directItems(chapterList, '[data-cp-chapter-item]').forEach(function(chapter) {
      var lessonList = chapter.querySelector('[data-lesson-list]');
      if (lessonList) refreshList(lessonList, '[data-cp-lesson-item]', '[data-cp-lesson-index]');
    });
    input.value = JSON.stringify(directItems(chapterList, '[data-cp-chapter-item]').map(function(chapter) {
      var lessonList = chapter.querySelector('[data-lesson-list]');
      return {
        chapterId: chapter.getAttribute('data-id'),
        lessonIds: lessonList ? directItems(lessonList, '[data-cp-lesson-item]').map(function(lesson) {
          return lesson.getAttribute('data-id');
        }) : [],
      };
    }));
  }
  function moveItem(row, parent, action) {
    if (action === 'top') parent.insertBefore(row, parent.firstElementChild);
    if (action === 'up' && row.previousElementSibling) parent.insertBefore(row, row.previousElementSibling);
    if (action === 'down' && row.nextElementSibling) parent.insertBefore(row.nextElementSibling, row);
    if (action === 'bottom') parent.appendChild(row);
  }
  root.addEventListener('click', function(ev) {
    var button = ev.target.closest('[data-sort-action]');
    if (!button) return;
    var scope = button.getAttribute('data-sort-scope');
    var action = button.getAttribute('data-sort-action');
    if (scope === 'chapter') {
      var chapter = button.closest('[data-cp-chapter-item]');
      if (chapter) moveItem(chapter, chapterList, action);
    }
    if (scope === 'lesson') {
      var lesson = button.closest('[data-cp-lesson-item]');
      var list = button.closest('[data-lesson-list]');
      if (lesson && list) moveItem(lesson, list, action);
    }
    refresh();
  });
  root.querySelectorAll('[data-cp-reset]').forEach(function(button) {
    button.addEventListener('click', function() { window.location.reload(); });
  });
  refresh();
})();
</script>
{% endblock %}
