{% import "components/user.html" as user with context %}
{% extends "layout/basic.html" %}
{% block content %}
<style>
.course-package-version { --cp-border: #d9e2ec; --cp-soft: #f7f9fc; --cp-ink: #172033; --cp-muted: #64748b; font-size: 14px; }
.course-package-version .section { border-radius: 8px; overflow: hidden; }
.course-package-version .section__header { padding: 14px 16px; }
.course-package-version .section__title { font-size: 18px; line-height: 1.35; }
.course-package-version .cp-hero { background: #f8fbff; border: 1px solid #dbe7f5; }
.course-package-version .cp-hero .section__title { font-size: 20px; }
.course-package-version .cp-summary { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 10px; margin-top: 14px; }
.course-package-version .cp-summary span { min-width: 0; padding: 10px 12px; border: 1px solid #e2e8f0; border-radius: 8px; background: #fff; color: var(--cp-muted); }
.course-package-version .cp-summary b { display: block; color: var(--cp-ink); font-size: 20px; line-height: 1.2; }
.course-package-version .cp-chapter { border: 1px solid var(--cp-border); background: #fff; }
.course-package-version .cp-chapter + .cp-chapter { margin-top: 12px; }
.course-package-version .cp-chapter-summary { display: block; list-style: none; cursor: pointer; }
.course-package-version .cp-chapter-summary::-webkit-details-marker { display: none; }
.course-package-version .cp-chapter-head { display: grid; grid-template-columns: minmax(0, 1fr) auto; align-items: center; gap: 12px; }
.course-package-version .cp-chapter-main { display: flex; align-items: center; gap: 12px; min-width: 0; }
.course-package-version .cp-index { flex: 0 0 auto; display: inline-flex; width: 28px; height: 28px; border-radius: 50%; align-items: center; justify-content: center; background: #e8f2ff; color: #0f172a; font-size: 13px; }
.course-package-version .cp-chapter-text { min-width: 0; }
.course-package-version .cp-chapter-title { margin: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; color: var(--cp-ink); font-weight: 500; }
.course-package-version .cp-chapter-meta { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 3px; color: var(--cp-muted); font-size: 12px; }
.course-package-version .cp-chapter-side { display: flex; align-items: center; justify-content: flex-end; min-width: 0; }
.course-package-version .cp-toggle { flex: 0 0 auto; width: 26px; height: 26px; border: 1px solid #cbd5e1; border-radius: 50%; position: relative; background: #fff; }
.course-package-version .cp-toggle:before { content: ""; position: absolute; left: 9px; top: 7px; width: 7px; height: 7px; border-right: 2px solid #475569; border-bottom: 2px solid #475569; transform: rotate(-45deg); transition: transform .18s ease; }
.course-package-version .cp-chapter[open] .cp-toggle:before { transform: rotate(45deg); top: 6px; }
.course-package-version .cp-chapter-body { border-top: 1px solid #edf2f7; padding: 0 16px 16px; background: #fbfdff; }
.course-package-version .cp-chapter-content { padding: 14px 2px 4px; }
.course-package-version .cp-lesson-list { list-style: none; margin: 0; padding: 12px 0 0; display: grid; gap: 8px; }
.course-package-version .cp-lesson { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 12px; align-items: start; padding: 12px 14px; border: 1px solid #e4ebf3; border-radius: 8px; background: #fff; }
.course-package-version .cp-lesson h3 { margin: 0 0 8px; color: var(--cp-ink); font-size: 16px; line-height: 1.35; }
.course-package-version .cp-lesson-content { margin-top: 8px; color: #334155; }
.course-package-version .cp-problems { display: flex; flex-wrap: wrap; align-items: center; gap: 6px; margin: 0; }
.course-package-version .cp-problems__label { color: var(--cp-ink); font-weight: 600; }
.course-package-version .cp-problems a { display: inline-flex; align-items: center; min-height: 24px; padding: 2px 9px; border-radius: 999px; background: #f1f5f9; color: #475569; line-height: 1.3; }
.course-package-version .cp-actions { display: flex; flex-wrap: wrap; justify-content: flex-end; gap: 8px; max-width: 100%; }
.course-package-version .cp-actions a { margin: 0 !important; }
.course-package-version .cp-actions .button { display: inline-flex; align-items: center; gap: 5px; height: 30px; padding: 0 10px; line-height: 28px; white-space: nowrap; font-size: 13px; }
.course-package-version .cp-actions .icon { font-size: 13px; }
.course-package-version .cp-empty { padding: 14px; border: 1px dashed #cbd5e1; border-radius: 8px; color: var(--cp-muted); background: #fff; }
.course-package-version .cp-side-title { padding: 12px 14px 6px; color: var(--cp-muted); font-weight: 600; }
.course-package-version .cp-nav { border-top: 1px solid #edf2f7; }
.course-package-version .cp-nav ol { margin: 0; padding: 4px 0 10px; list-style: none; }
.course-package-version .cp-nav a { display: flex; align-items: center; gap: 8px; padding: 6px 14px; color: #334155; }
.course-package-version .cp-nav a:hover { background: var(--cp-soft); }
.course-package-version .cp-nav span { display: inline-flex; width: 22px; height: 22px; align-items: center; justify-content: center; border-radius: 50%; background: #eef2f7; color: #475569; font-size: 12px; }
.course-package-version .side .menu__link { font-size: 14px; }
@media screen and (max-width: 1180px) {
  .course-package-version .cp-chapter-head { grid-template-columns: 1fr; align-items: start; }
  .course-package-version .cp-chapter-side,
  .course-package-version .cp-actions { justify-content: flex-start; }
}
@media screen and (max-width: 720px) {
  .course-package-version .cp-summary { grid-template-columns: 1fr; }
  .course-package-version .cp-lesson { grid-template-columns: 1fr; display: grid; }
}
</style>
{% include "course_package_style.html" %}
<div class="row course-package-version course-package-ui" data-sticky-parent>
  <div class="medium-9 columns">
    <div class="section cp-hero">
      <div class="section__header">
        <h1 class="section__title"><a href="{{ url('course_package_detail', cpid=cpdoc.docId) }}">{{ cpdoc.title }}</a>: {{ vpdoc.version }}</h1>
        {% if canManage %}
        <div class="section__tools cp-order-toolbar">
          <a class="rounded primary button cp-order-cta" href="{{ url('course_package_structure_order', cpid=cpdoc.docId, vid=vpdoc.docId) }}"><span class="icon icon-sliders"></span> {{ _('调整章/节顺序') }}</a>
        </div>
        {% endif %}
      </div>
      <div class="section__body typo richmedia">
        {{ vpdoc.content|default('')|markdown|safe }}
        <div class="cp-summary">
          <span><b>{{ summary.chapterCount }}</b>{{ _('章') }}</span>
          <span><b>{{ summary.lessonCount }}</b>{{ _('节') }}</span>
          <span><b>{{ summary.problemCount }}</b>{{ _('题目') }}</span>
        </div>
      </div>
    </div>
    {% if not chapters.length %}
    <div class="section">
      <div class="section__body typo">
        <p>{{ _('这个版本还没有章。') }}</p>
        {% if canManage %}
        <p><a class="rounded primary button" href="{{ url('course_package_chapter_create', cpid=cpdoc.docId, vid=vpdoc.docId) }}">{{ _('创建第一章') }}</a></p>
        {% endif %}
      </div>
    </div>
    {% endif %}
    {% for chapter in chapters %}
    <details id="chapter-{{ chapter.id }}" class="section cp-chapter" {% if chapters.length <= 2 and loop.first %}open{% endif %}>
      <summary class="section__header cp-chapter-summary">
        <div class="cp-chapter-head">
          <div class="cp-chapter-main">
            <span class="cp-index">{{ loop.index }}</span>
            <span class="cp-toggle" aria-hidden="true"></span>
            <div class="cp-chapter-text">
              <h2 class="section__title cp-chapter-title">{{ chapter.title }}</h2>
              <div class="cp-chapter-meta">
                <span>{{ chapter.lessons.length }} {{ _('节') }}</span>
              </div>
            </div>
          </div>
          <div class="cp-chapter-side">
            {% if canManage or canCopy %}
            <div class="section__tools cp-actions" onclick="event.stopPropagation()">
              {% if canManage %}
              <a class="button rounded primary" href="{{ url('course_package_chapter_edit', cpid=cpdoc.docId, vid=vpdoc.docId, chapterId=chapter.id) }}"><span class="icon icon-edit"></span>{{ _('编辑章') }}</a>
              <a class="button rounded" href="{{ url('course_package_lesson_create', cpid=cpdoc.docId, vid=vpdoc.docId, chapterId=chapter.id) }}"><span class="icon icon-add"></span>{{ _('创建节') }}</a>
              {% endif %}
              {% if canCopy %}
              <a class="button rounded" href="{{ url('course_package_copy', cpid=cpdoc.docId, vid=vpdoc.docId, query={mode:'chapter', nodeId:chapter.id}) }}"><span class="icon icon-copy"></span>{{ _('复制本章') }}</a>
              {% endif %}
            </div>
            {% endif %}
          </div>
        </div>
      </summary>
      <div class="cp-chapter-body">
        {% if chapter.content %}
        <div class="cp-chapter-content typo richmedia">{{ chapter.content|markdown|safe }}</div>
        {% endif %}
        {% if chapter.lessons.length %}
        <ol class="cp-lesson-list">
          {% for lesson in chapter.lessons %}
          <li class="cp-lesson">
            <div class="cp-lesson-main">
              <h3>{{ lesson.title }}</h3>
              {% if lesson.pids.length %}
              <p class="cp-problems"><span class="cp-problems__label">{{ _('题目') }}:</span>{% for pid in lesson.pids %}<a href="{{ url('problem_detail', pid=pid) }}">P{{ pid }}</a>{% endfor %}</p>
              {% endif %}
              {% if lesson.content %}<div class="cp-lesson-content typo richmedia">{{ lesson.content|markdown|safe }}</div>{% endif %}
            </div>
            {% if canManage or canCopy %}
            <div class="cp-actions">
              {% if canManage %}
              <a class="button rounded primary" href="{{ url('course_package_lesson_edit', cpid=cpdoc.docId, vid=vpdoc.docId, chapterId=chapter.id, lessonId=lesson.id) }}"><span class="icon icon-edit"></span>{{ _('编辑') }}</a>
              {% endif %}
              {% if canCopy %}
              <a class="button rounded" href="{{ url('course_package_copy', cpid=cpdoc.docId, vid=vpdoc.docId, query={mode:'lesson', nodeId:lesson.id}) }}"><span class="icon icon-copy"></span>{{ _('复制') }}</a>
              {% endif %}
            </div>
            {% endif %}
          </li>
          {% endfor %}
        </ol>
        {% else %}
        <div class="cp-empty">{{ _('本章还没有节。') }}</div>
        {% endif %}
      </div>
    </details>
    {% endfor %}
  </div>
  <div class="medium-3 columns" data-sticky="large">
    <div class="section side">
      <ol class="menu">
        {% if canManage %}
        <li class="menu__item"><a class="menu__link" href="{{ url('course_package_version_edit', cpid=cpdoc.docId, vid=vpdoc.docId) }}"><span class="icon icon-edit"></span> {{ _('Edit') }}</a></li>
        <li class="menu__item"><a class="menu__link" href="{{ url('course_package_chapter_create', cpid=cpdoc.docId, vid=vpdoc.docId) }}"><span class="icon icon-add"></span> {{ _('创建章') }}</a></li>
        <li class="menu__item"><a class="menu__link cp-order-menu" href="{{ url('course_package_structure_order', cpid=cpdoc.docId, vid=vpdoc.docId) }}"><span class="icon icon-sliders"></span> {{ _('调整章/节顺序') }}</a></li>
        {% endif %}
        {% if canCopy %}
        <li class="menu__item"><a class="menu__link" href="{{ url('course_package_copy', cpid=cpdoc.docId, vid=vpdoc.docId, query={mode:'package'}) }}"><span class="icon icon-copy"></span> {{ _('复制整个课程包') }}</a></li>
        {% endif %}
        {% if canExport %}
        <li class="menu__item"><a class="menu__link" href="{{ url('course_package_export', cpid=cpdoc.docId, vid=vpdoc.docId) }}"><span class="icon icon-download"></span> {{ _('导出课程包 ZIP') }}</a></li>
        {% endif %}
      </ol>
      {% if chapters.length %}
      <div class="cp-nav">
        <div class="cp-side-title">{{ _('结构') }}</div>
        <ol>
          {% for chapter in chapters %}
          <li><a href="#chapter-{{ chapter.id }}"><span>{{ loop.index }}</span>{{ chapter.title }}</a></li>
          {% endfor %}
        </ol>
      </div>
      {% endif %}
      <div class="section__body typo">
        <dl class="large horizontal">
          <dt>{{ _('Created By') }}</dt>
          <dd>{{ user.render_inline(udoc, badge=false) }}</dd>
          <dt>{{ _('章') }}</dt>
          <dd>{{ summary.chapterCount }}</dd>
          <dt>{{ _('版本定位') }}</dt>
          <dd>{{ _('内容快照') }}</dd>
        </dl>
      </div>
    </div>
  </div>
</div>
{% endblock %}
